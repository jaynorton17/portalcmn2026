# CoverMeNow ONE deploy configuration (example values only)
# Do not commit real credentials.

# Required target settings
CMN_HOST=access-5018438942.webspace-host.com
CMN_USER=su357722
CMN_PATH=/home/www/public/wp-content/plugins/covermenow-one

# Optional SSH settings
CMN_PORT=22
CMN_KEY=
# Legacy alias (still supported)
CMN_IDENTITY=

# Optional deploy behavior
CMN_VERIFY=1
CMN_VERSION=0.1.25
CMN_TOKEN=

# Current shared deploys use password auth via SFTP_PASS.
# Put the real password in .env.local only. Do not commit it.
SFTP_PASS=

# Legacy env vars still supported:
# CMN_SFTP_HOST, CMN_SFTP_USER, CMN_SFTP_PORT, CMN_REMOTE_PLUGIN_DIR

# Portal audit credentials (local only)
# Put real values in .env.local and source it before running audit scripts.
CMN_AUDIT_ADMIN_EMAIL=
CMN_AUDIT_ADMIN_PASS=
CMN_AUDIT_SCHOOL_EMAIL=
CMN_AUDIT_SCHOOL_PASS=
CMN_AUDIT_CANDIDATE_EMAIL=
CMN_AUDIT_CANDIDATE_PASS=
