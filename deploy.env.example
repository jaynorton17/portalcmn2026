# Required deploy target settings
CMN_HOST=example-sftp-host
CMN_USER=example-user
CMN_PATH=/home/www/public/wp-content/plugins/covermenow-one

# Optional
CMN_PORT=22
CMN_KEY=
CMN_VERIFY=1
CMN_VERSION=0.1.25
CMN_TOKEN=

# Optional password auth fallback (if no SSH key)
SFTP_PASS=

# Legacy env vars still supported by deploy_portal.sh:
# CMN_SFTP_HOST, CMN_SFTP_USER, CMN_SFTP_PORT, CMN_REMOTE_PLUGIN_DIR
