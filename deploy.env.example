# CoverMeNow ONE deploy configuration (example values only)
# Do not commit real credentials.

# Required target settings
CMN_HOST=access-5018438942.webspace-host.com
CMN_USER=su000000
CMN_PATH=/home/www/public/wp-content/plugins/covermenow-one

# Optional SSH settings
CMN_PORT=22
CMN_KEY=/home/you/.ssh/id_ed25519
# Legacy alias (still supported)
CMN_IDENTITY=

# Optional deploy behavior
CMN_VERIFY=1
CMN_VERSION=0.1.25
CMN_TOKEN=

# Optional password fallback (if not using CMN_IDENTITY)
SFTP_PASS=

# Legacy env vars still supported:
# CMN_SFTP_HOST, CMN_SFTP_USER, CMN_SFTP_PORT, CMN_REMOTE_PLUGIN_DIR
